APP_ENV=production
ALLOW_DEMO_SEED=false

IMAGE_TAG=release-git-sha
APP_IMAGE=esi-web-tv-app
WORKER_IMAGE=esi-web-tv-worker

APP_DOMAIN=web-tv.example.edu
LIVEKIT_DOMAIN=livekit.example.edu
S3_DOMAIN=s3.example.edu
TURN_DOMAIN=turn.example.edu
ACME_EMAIL=ops@example.edu
UPLOAD_MAX_BODY_SIZE=16GB

POSTGRES_USER=esitv_prod
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=esitvdb
DATABASE_URL=postgresql://esitv_prod:replace-with-strong-postgres-password@db:5432/esitvdb?schema=public
AUTH_SECRET=generate-at-least-32-random-characters
NEXTAUTH_URL=https://web-tv.example.edu
NEXT_PUBLIC_APP_URL=https://web-tv.example.edu

LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret-at-least-32-chars
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.example.edu
LIVEKIT_WEBHOOK_URL=https://web-tv.example.edu/api/livekit/webhook
LIVEKIT_TOKEN_TTL_SECONDS=600
LIVEKIT_ANONYMOUS_TOKEN_TTL_SECONDS=120
LIVEKIT_ROOM_EMPTY_TIMEOUT_SECONDS=600
LIVEKIT_ROOM_DEPARTURE_TIMEOUT_SECONDS=60
LIVEKIT_MAX_PARTICIPANTS=100
LIVEKIT_PUBLIC_MAX_PARTICIPANTS=50
LIVEKIT_RECORDING_ENABLED=true

MINIO_ENDPOINT=s3.example.edu
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-strong-minio-root-password
MINIO_ACCESS_KEY=replace-with-minio-application-access-key
MINIO_SECRET_KEY=replace-with-minio-application-secret-key
MINIO_VIDEO_BUCKET=esitv-videos
NEXT_PUBLIC_MEDIA_URL=https://s3.example.edu

REDIS_URL=redis://redis:6379
MEDIA_SIGNED_URL_TTL_SECONDS=60
MEDIA_MAX_DURATION_SECONDS=14400
MEDIA_MAX_FRAME_PIXELS=8294400
MEDIA_FFMPEG_TIMEOUT_SECONDS=3600
MEDIA_FFMPEG_THREADS=2
MEDIA_HLS_SEGMENT_SECONDS=6
MEDIA_WORKER_VERSION=release-git-sha
MEDIA_WORKER_CONCURRENCY=2
MEDIA_WORKER_TMP_SIZE=12g
MEDIA_WORKER_CPUS=2.00
MEDIA_WORKER_MEMORY=4g

BOOTSTRAP_ADMIN_EMAIL=admin@esi.dz
BOOTSTRAP_ADMIN_NAME=Platform Admin
BOOTSTRAP_ADMIN_PASSWORD=

METRICS_BEARER_TOKEN=
PROMETHEUS_RETENTION=15d

BACKUP_DIR=backups
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_REMOTE_RSYNC_TARGET=

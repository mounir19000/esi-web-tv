APP_ENV=production
ALLOW_DEMO_SEED=false

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/esitvdb?schema=public
AUTH_SECRET=generate-at-least-32-random-characters
NEXTAUTH_URL=https://web-tv.example.edu

LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret-at-least-32-chars
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.example.edu
LIVEKIT_WEBHOOK_URL=https://web-tv.example.edu/api/livekit/webhook
LIVEKIT_TOKEN_TTL_SECONDS=600
LIVEKIT_ANONYMOUS_TOKEN_TTL_SECONDS=120
LIVEKIT_ROOM_EMPTY_TIMEOUT_SECONDS=600
LIVEKIT_ROOM_DEPARTURE_TIMEOUT_SECONDS=60
LIVEKIT_MAX_PARTICIPANTS=100
LIVEKIT_PUBLIC_MAX_PARTICIPANTS=50
LIVEKIT_RECORDING_ENABLED=true

MINIO_ENDPOINT=s3.example.edu
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=replace-with-minio-application-access-key
MINIO_SECRET_KEY=replace-with-minio-application-secret-key
MINIO_VIDEO_BUCKET=esitv-videos

REDIS_URL=rediss://USER:PASSWORD@redis.example.edu:6379
MEDIA_SIGNED_URL_TTL_SECONDS=60
MEDIA_WORKER_VERSION=release-git-sha-or-image-tag
MEDIA_WORKER_CONCURRENCY=2

BOOTSTRAP_ADMIN_EMAIL=admin@esi.dz
BOOTSTRAP_ADMIN_NAME=Platform Admin
BOOTSTRAP_ADMIN_PASSWORD=

APP_ENV=local
ALLOW_DEMO_SEED=true

POSTGRES_USER=esitv_local
POSTGRES_PASSWORD=local-postgres-password-change-me
POSTGRES_DB=esitvdb
DATABASE_URL=postgresql://esitv_local:local-postgres-password-change-me@localhost:5433/esitvdb?schema=public
WORKER_DATABASE_URL=postgresql://esitv_local:local-postgres-password-change-me@db:5432/esitvdb?schema=public

AUTH_SECRET=local-auth-secret-change-me-32-characters-minimum
NEXTAUTH_URL=http://localhost:3000

LIVEKIT_API_KEY=local-livekit-key
LIVEKIT_API_SECRET=local-livekit-secret-change-me-32-characters
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_WEBHOOK_URL=http://host.docker.internal:3000/api/livekit/webhook
LIVEKIT_TOKEN_TTL_SECONDS=600
LIVEKIT_ANONYMOUS_TOKEN_TTL_SECONDS=120
LIVEKIT_ROOM_EMPTY_TIMEOUT_SECONDS=600
LIVEKIT_ROOM_DEPARTURE_TIMEOUT_SECONDS=60
LIVEKIT_MAX_PARTICIPANTS=100
LIVEKIT_PUBLIC_MAX_PARTICIPANTS=50
LIVEKIT_RECORDING_ENABLED=true

MINIO_ROOT_USER=local-minio-root
MINIO_ROOT_PASSWORD=local-minio-root-password-change-me
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=esitv-local-media-app
MINIO_SECRET_KEY=local-minio-app-password-change-me
MINIO_VIDEO_BUCKET=esitv-videos

REDIS_URL=redis://localhost:6379
MEDIA_SIGNED_URL_TTL_SECONDS=60
MEDIA_MAX_DURATION_SECONDS=14400
MEDIA_MAX_FRAME_PIXELS=8294400
MEDIA_FFMPEG_TIMEOUT_SECONDS=3600
MEDIA_FFMPEG_THREADS=2
MEDIA_HLS_SEGMENT_SECONDS=6
MEDIA_WORKER_VERSION=local-dev
MEDIA_WORKER_CONCURRENCY=1

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

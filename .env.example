# Copy this file to .env.local for development or .env.production for deployment.
# Replace every "replace-with-..." value before starting the app.

APP_ENV=local
ALLOW_DEMO_SEED=false

# Public browser origins. Production must use HTTPS for app/media and WSS for LiveKit.
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Database.
POSTGRES_USER=replace-with-postgres-user
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=esitvdb
DATABASE_URL=postgresql://replace-with-postgres-user:replace-with-postgres-password@localhost:5433/esitvdb?schema=public
WORKER_DATABASE_URL=postgresql://replace-with-postgres-user:replace-with-postgres-password@db:5432/esitvdb?schema=public

# Authentication. Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LiveKit.
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret-at-least-32-chars
LIVEKIT_WEBHOOK_URL=http://host.docker.internal:3000/api/livekit/webhook
LIVEKIT_TOKEN_TTL_SECONDS=600
LIVEKIT_ANONYMOUS_TOKEN_TTL_SECONDS=120
LIVEKIT_ROOM_EMPTY_TIMEOUT_SECONDS=600
LIVEKIT_ROOM_DEPARTURE_TIMEOUT_SECONDS=60
LIVEKIT_MAX_PARTICIPANTS=100
LIVEKIT_PUBLIC_MAX_PARTICIPANTS=50
LIVEKIT_RECORDING_ENABLED=false

# MinIO/S3. Application credentials must be distinct from root credentials.
MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-minio-root-password
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-with-minio-application-access-key
MINIO_SECRET_KEY=replace-with-minio-application-secret-key
MINIO_VIDEO_BUCKET=esitv-videos

# Redis and media worker.
REDIS_URL=redis://localhost:6379
MEDIA_SIGNED_URL_TTL_SECONDS=60
MEDIA_MAX_DURATION_SECONDS=14400
MEDIA_MAX_FRAME_PIXELS=8294400
MEDIA_FFMPEG_TIMEOUT_SECONDS=3600
MEDIA_FFMPEG_THREADS=2
MEDIA_HLS_SEGMENT_SECONDS=6
MEDIA_WORKER_VERSION=local-dev
MEDIA_WORKER_CONCURRENCY=1

# Optional one-time admin bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

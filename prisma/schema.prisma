// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  STUDENT
  TEACHER
  ADMIN
}

enum VideoType {
  TEACHING
  CLUB
  EXPLANATION
  OTHER
}

enum UploadSessionState {
  INITIATED
  UPLOADING
  COMPLETED
  ABORTED
  EXPIRED
}

enum VideoStatus {
  UPLOADING
  PENDING
  PROCESSING
  READY
  FAILED
  DELETING
}

enum StreamStatus {
  DRAFT
  STARTING
  LIVE
  ENDING
  ENDED
  FAILED
}

enum RecordingPolicy {
  NONE
  AUTO
}

enum RecordingStatus {
  RECORDING
  READY
  PROCESSING
  PUBLISHED
  FAILED
  DISCARDED
}

enum RecordingJobStatus {
  STARTING
  ACTIVE
  ENDING
  COMPLETED
  FAILED
  ABORTED
}

enum AuditEventType {
  LOGIN
  LOGOUT
  SESSION_REVOKE
  ROLE_CHANGE
  USER_DISABLE
  USER_CREATE
  PASSWORD_RESET
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  password       String?
  emailVerified  DateTime?
  image          String?
  role           Role      @default(GUEST)
  yearGroup      String? // e.g. "1CP", "2CP", etc.
  isActive       Boolean   @default(true)
  disabledAt     DateTime?
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  videos              Video[]         @relation("Uploader")
  liveStreams         LiveStream[]    @relation("Host")
  uploadSessions      UploadSession[] @relation("UploadOwner")
  accounts            Account[]
  sessions            Session[]
  auditEventsAuthored AuditEvent[]    @relation("AuditActor")
  auditEventsSubject  AuditEvent[]    @relation("AuditSubject")

  @@index([isActive, role])
}

model Module {
  id             String          @id @default(cuid())
  name           String
  yearGroup      String // e.g. "1CP"
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  videos         Video[]
  liveStreams    LiveStream[]
  uploadSessions UploadSession[]

  @@unique([name, yearGroup])
  @@index([yearGroup, name])
}

model Video {
  id                      String      @id @default(cuid())
  title                   String
  description             String?
  type                    VideoType
  isPublic                Boolean     @default(false)
  status                  VideoStatus @default(READY)
  url                     String // MinIO URL or path
  thumbnailUrl            String?
  sourceKey               String?
  processingVersion       Int         @default(1)
  processingAttempts      Int         @default(0)
  processingErrorCode     String?
  processingErrorMessage  String?
  queuedAt                DateTime?
  processingStartedAt     DateTime?
  processingCompletedAt   DateTime?
  processingWorkerVersion String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  uploaderId String
  uploader   User   @relation("Uploader", fields: [uploaderId], references: [id], onDelete: Restrict)

  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  publishedRecording Recording? @relation("PublishedRecording")

  @@index([status, createdAt])
  @@index([uploaderId, status])
  @@index([isPublic, status, createdAt])
  @@index([type, status, createdAt])
  @@index([moduleId, status, createdAt])
  @@index([uploaderId, createdAt])
}

model UploadSession {
  id                String             @id @default(cuid())
  title             String
  description       String?
  type              VideoType
  isPublic          Boolean            @default(false)
  originalFileName  String?
  objectKey         String             @unique
  expectedSize      BigInt
  expectedPartSize  Int
  expectedType      String
  checksum          String?
  multipartUploadId String
  state             UploadSessionState @default(INITIATED)
  expiresAt         DateTime
  completedAt       DateTime?
  videoId           String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  ownerId String
  owner   User   @relation("UploadOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@index([ownerId, state, expiresAt])
  @@index([moduleId, state, createdAt])
}

model LiveStream {
  id                  String          @id @default(cuid())
  title               String
  description         String?
  isPublic            Boolean         @default(false)
  isLive              Boolean         @default(false)
  status              StreamStatus    @default(ENDED)
  recordingPolicy     RecordingPolicy @default(NONE)
  streamKey           String          @unique @default(uuid())
  providerRoomId      String?
  participantCount    Int             @default(0)
  lastProviderEventAt DateTime?
  startedAt           DateTime?
  endedAt             DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  hostId String
  host   User   @relation("Host", fields: [hostId], references: [id], onDelete: Restrict)

  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  recordings    Recording[]
  recordingJobs RecordingJob[]

  @@index([isLive, isPublic, startedAt])
  @@index([status, startedAt])
  @@index([moduleId, isLive, startedAt])
  @@index([hostId, isLive, startedAt])
}

model Recording {
  id              String          @id @default(cuid())
  status          RecordingStatus @default(RECORDING)
  objectKey       String?         @unique
  sizeBytes       BigInt?
  durationSeconds Int?
  errorCode       String?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  publishedAt     DateTime?
  discardedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  streamId String
  stream   LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  publishedVideoId String? @unique
  publishedVideo   Video?  @relation("PublishedRecording", fields: [publishedVideoId], references: [id], onDelete: SetNull)

  jobs RecordingJob[]

  @@index([streamId, status])
  @@index([status, createdAt])
}

model RecordingJob {
  id               String             @id @default(cuid())
  status           RecordingJobStatus @default(STARTING)
  providerEgressId String?            @unique
  outputKey        String
  errorCode        String?
  errorMessage     String?
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  streamId String
  stream   LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([streamId, status])
  @@index([recordingId, status])
}

// NextAuth standard tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditEvent {
  id        String         @id @default(cuid())
  type      AuditEventType
  actorId   String?
  subjectId String?
  metadata  Json?
  createdAt DateTime       @default(now())

  actor   User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  subject User? @relation("AuditSubject", fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([subjectId, createdAt])
  @@index([type, createdAt])
}

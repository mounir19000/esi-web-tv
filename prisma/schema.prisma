// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  STUDENT
  TEACHER
  ADMIN
}

enum ProvisioningStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AudienceType {
  PUBLIC
  ESI
  COHORT
  MODULE
  SELECTED_USERS
}

enum VideoType {
  TEACHING
  CLUB
  EXPLANATION
  OTHER
}

enum UploadSessionState {
  INITIATED
  UPLOADING
  COMPLETED
  ABORTED
  EXPIRED
}

enum VideoStatus {
  UPLOADING
  PENDING
  PROCESSING
  READY
  FAILED
  DELETING
}

enum ThumbnailStatus {
  PENDING
  READY
  FAILED
  SKIPPED
}

enum VideoVariantStatus {
  READY
  FAILED
}

enum MediaAssetType {
  SOURCE
  HLS_MASTER
  HLS_VARIANT_PLAYLIST
  HLS_SEGMENT
  THUMBNAIL
  CAPTION
}

enum MediaAssetStatus {
  PENDING
  READY
  FAILED
}

enum StreamStatus {
  DRAFT
  STARTING
  LIVE
  ENDING
  ENDED
  FAILED
}

enum RecordingPolicy {
  NONE
  AUTO
}

enum RecordingStatus {
  RECORDING
  READY
  PROCESSING
  PUBLISHED
  FAILED
  DISCARDED
}

enum RecordingJobStatus {
  STARTING
  ACTIVE
  ENDING
  COMPLETED
  FAILED
  ABORTED
}

enum AuditEventType {
  LOGIN
  LOGOUT
  SESSION_REVOKE
  ROLE_CHANGE
  USER_DISABLE
  USER_CREATE
  PASSWORD_RESET
}

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String?            @unique
  password           String?
  emailVerified      DateTime?
  image              String?
  role               Role               @default(GUEST)
  yearGroup          String? // e.g. "1CP", "2CP", etc.
  provisioningStatus ProvisioningStatus @default(APPROVED)
  isActive           Boolean            @default(true)
  disabledAt         DateTime?
  sessionVersion     Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  videos                  Video[]                   @relation("Uploader")
  liveStreams             LiveStream[]              @relation("Host")
  uploadSessions          UploadSession[]           @relation("UploadOwner")
  cohortMemberships       CohortMembership[]
  moduleEnrollments       StudentModuleEnrollment[]
  teacherAssignments      TeacherModuleAssignment[]
  videoAudienceUsers      VideoAudienceUser[]
  liveStreamAudienceUsers LiveStreamAudienceUser[]
  accounts                Account[]
  sessions                Session[]
  auditEventsAuthored     AuditEvent[]              @relation("AuditActor")
  auditEventsSubject      AuditEvent[]              @relation("AuditSubject")

  @@index([isActive, role])
}

model Module {
  id                 String                    @id @default(cuid())
  name               String
  yearGroup          String // e.g. "1CP"
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  videos             Video[]
  liveStreams        LiveStream[]
  uploadSessions     UploadSession[]
  studentEnrollments StudentModuleEnrollment[]
  teacherAssignments TeacherModuleAssignment[]

  @@unique([name, yearGroup])
  @@index([yearGroup, name])
}

model Cohort {
  id        String   @id @default(cuid())
  name      String   @unique
  yearGroup String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    CohortMembership[]
  videos         Video[]
  liveStreams    LiveStream[]
  uploadSessions UploadSession[]

  @@index([yearGroup, name])
}

model Video {
  id                      String          @id @default(cuid())
  title                   String
  description             String?
  type                    VideoType
  isPublic                Boolean         @default(false)
  audience                AudienceType    @default(ESI)
  status                  VideoStatus     @default(READY)
  url                     String // MinIO URL or path
  thumbnailUrl            String?
  sourceKey               String?
  durationSeconds         Float?
  width                   Int?
  height                  Int?
  videoCodec              String?
  audioCodec              String?
  container               String?
  bitrate                 Int?
  sourceSizeBytes         BigInt?
  sourceChecksumSha256    String?
  sourceContentType       String?
  thumbnailStatus         ThumbnailStatus @default(PENDING)
  processingVersion       Int             @default(1)
  processingAttempts      Int             @default(0)
  processingErrorCode     String?
  processingErrorMessage  String?
  queuedAt                DateTime?
  processingStartedAt     DateTime?
  processingCompletedAt   DateTime?
  processingWorkerVersion String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  uploaderId String
  uploader   User   @relation("Uploader", fields: [uploaderId], references: [id], onDelete: Restrict)

  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  cohortId String?
  cohort   Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  publishedRecording Recording?          @relation("PublishedRecording")
  variants           VideoVariant[]
  mediaAssets        MediaAsset[]
  audienceUsers      VideoAudienceUser[]

  @@index([status, createdAt])
  @@index([uploaderId, status])
  @@index([isPublic, status, createdAt])
  @@index([audience, status, createdAt])
  @@index([type, status, createdAt])
  @@index([moduleId, status, createdAt])
  @@index([cohortId, status, createdAt])
  @@index([uploaderId, createdAt])
}

model VideoVariant {
  id          String             @id @default(cuid())
  label       String
  width       Int
  height      Int
  bitrate     Int
  codec       String
  playlistKey String             @unique
  status      VideoVariantStatus @default(READY)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  mediaAssets MediaAsset[]

  @@unique([videoId, label])
  @@index([videoId, height])
}

model MediaAsset {
  id             String           @id @default(cuid())
  type           MediaAssetType
  status         MediaAssetStatus @default(READY)
  storageKey     String           @unique
  contentType    String
  sizeBytes      BigInt
  checksumSha256 String
  language       String?
  label          String?
  isDefault      Boolean          @default(false)
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  variantId String?
  variant   VideoVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([videoId, type, status])
  @@index([variantId, type])
  @@index([type, status])
}

model UploadSession {
  id                String             @id @default(cuid())
  title             String
  description       String?
  type              VideoType
  isPublic          Boolean            @default(false)
  audience          AudienceType       @default(ESI)
  originalFileName  String?
  objectKey         String             @unique
  expectedSize      BigInt
  expectedPartSize  Int
  expectedType      String
  checksum          String?
  multipartUploadId String
  state             UploadSessionState @default(INITIATED)
  expiresAt         DateTime
  completedAt       DateTime?
  videoId           String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  ownerId String
  owner   User   @relation("UploadOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  cohortId String?
  cohort   Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  @@index([ownerId, state, expiresAt])
  @@index([moduleId, state, createdAt])
  @@index([cohortId, state, createdAt])
}

model LiveStream {
  id                  String          @id @default(cuid())
  title               String
  description         String?
  isPublic            Boolean         @default(false)
  audience            AudienceType    @default(ESI)
  isLive              Boolean         @default(false)
  status              StreamStatus    @default(ENDED)
  recordingPolicy     RecordingPolicy @default(NONE)
  streamKey           String          @unique @default(uuid())
  providerRoomId      String?
  participantCount    Int             @default(0)
  lastProviderEventAt DateTime?
  startedAt           DateTime?
  endedAt             DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  hostId String
  host   User   @relation("Host", fields: [hostId], references: [id], onDelete: Restrict)

  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  cohortId String?
  cohort   Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  recordings              Recording[]
  recordingJobs           RecordingJob[]
  liveStreamAudienceUsers LiveStreamAudienceUser[]

  @@index([isLive, isPublic, startedAt])
  @@index([audience, isLive, startedAt])
  @@index([status, startedAt])
  @@index([moduleId, isLive, startedAt])
  @@index([cohortId, isLive, startedAt])
  @@index([hostId, isLive, startedAt])
}

model CohortMembership {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([userId, cohortId])
  @@index([cohortId, userId])
}

model StudentModuleEnrollment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([moduleId, userId])
}

model TeacherModuleAssignment {
  id         String   @id @default(cuid())
  canPublish Boolean  @default(true)
  canManage  Boolean  @default(true)
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([moduleId, userId])
}

model VideoAudienceUser {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@index([userId])
}

model LiveStreamAudienceUser {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  liveStreamId String
  liveStream   LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveStreamId, userId])
  @@index([userId])
}

model Recording {
  id              String          @id @default(cuid())
  status          RecordingStatus @default(RECORDING)
  objectKey       String?         @unique
  sizeBytes       BigInt?
  durationSeconds Int?
  errorCode       String?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  publishedAt     DateTime?
  discardedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  streamId String
  stream   LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  publishedVideoId String? @unique
  publishedVideo   Video?  @relation("PublishedRecording", fields: [publishedVideoId], references: [id], onDelete: SetNull)

  jobs RecordingJob[]

  @@index([streamId, status])
  @@index([status, createdAt])
}

model RecordingJob {
  id               String             @id @default(cuid())
  status           RecordingJobStatus @default(STARTING)
  providerEgressId String?            @unique
  outputKey        String
  errorCode        String?
  errorMessage     String?
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  streamId String
  stream   LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([streamId, status])
  @@index([recordingId, status])
}

// NextAuth standard tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditEvent {
  id        String         @id @default(cuid())
  type      AuditEventType
  actorId   String?
  subjectId String?
  metadata  Json?
  createdAt DateTime       @default(now())

  actor   User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  subject User? @relation("AuditSubject", fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([subjectId, createdAt])
  @@index([type, createdAt])
}

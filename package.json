{
  "name": "esi-web-tv",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10.9 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format:check": "eslint --format stylish .",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "test:unit": "tsx --import ./tests/setup-env.ts --test tests/unit/*.test.ts",
    "test:integration": "tsx --import ./tests/setup-env.ts --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:integration",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:livekit-smoke": "tsx scripts/livekit-smoke.ts",
    "reconcile:livekit": "tsx scripts/reconcile-livekit.ts",
    "db:seed-listing-fixtures": "tsx scripts/seed-listing-fixtures.ts",
    "db:explain-listings": "tsx scripts/explain-listing-queries.ts",
    "ops:prod-config": "docker compose --env-file .env.production.example -f compose.prod.yml config --quiet",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "worker:media": "tsx src/workers/media-worker.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@livekit/components-react": "^2.9.23",
    "@livekit/components-styles": "^1.2.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.1",
    "fluent-ffmpeg": "^2.1.3",
    "hls.js": "^1.7.0",
    "ioredis": "^6.0.0",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "minio": "^8.0.7",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10",
    "eslint-config-next": "^16.3.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
